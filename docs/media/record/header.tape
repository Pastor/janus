# Общие настройки записи: шрифт, размер окна, палитра. Подставляется
# record.sh перед каждым сценарием из tapes/.
Set Shell bash
Set Width 1300
Set Height 720
Set FontFamily "Menlo"
Set FontSize 15
Set LetterSpacing 1
Set Padding 12
Set Framerate 25
Set Theme { "name": "janus", "background": "#000000", "foreground": "#d0d0d0", "black": "#000000", "red": "#e06c75", "green": "#98c379", "yellow": "#e5c07b", "blue": "#61afef", "magenta": "#c678dd", "cyan": "#56b6c2", "white": "#d0d0d0", "brightBlack": "#5c6370", "brightRed": "#e06c75", "brightGreen": "#98c379", "brightYellow": "#e5c07b", "brightBlue": "#61afef", "brightMagenta": "#c678dd", "brightCyan": "#56b6c2", "brightWhite": "#ffffff", "cursor": "#d0d0d0", "selection": "#333333" }
Env COLORTERM "truecolor"
Env HOME "@HOME@"
