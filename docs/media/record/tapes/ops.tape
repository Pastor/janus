# Операции с файлами: выделение, копирование, конфликт имён, удаление,
# поиск по имени и копирование большого файла с прогрессом.
Hide
Type "@JANUS@ --lang @LANG@ ~/demo/photos ~/demo/backup"
Enter
Sleep 1.5
Show
Sleep 0.6
Space
Sleep 0.4
Space
Sleep 1.2
Type "c"
Sleep 1.8
Up
Sleep 0.3
Up
Sleep 0.5
Space
Sleep 0.4
Space
Sleep 0.8
Type "c"
Sleep 2
Type "R"
Sleep 1.5
Tab
Sleep 0.8
Type "d"
Sleep 1.5
Escape
Sleep 0.6
Type "D"
Sleep 1.5
Type "D"
Sleep 1.5
Tab
Sleep 0.5
Left
Sleep 1
Type "f"
Sleep 0.6
Type@250ms "ubunt"
Sleep 1.2
Enter
Sleep 1.2
Escape
Sleep 0.8
Type "c"
Sleep 4
