# Поиск по содержимому и по имени.
Hide
Type "@JANUS@ --lang @LANG@ ~/demo ~/demo/project"
Enter
Sleep 1.5
Type "/"
Sleep 0.3
Show
Sleep 0.5
Type@100ms "retrying"
Sleep 1.5
Down
Sleep 0.6
Down
Sleep 0.6
Down
Sleep 2.8
Escape
Sleep 0.7
Type "f"
Sleep 0.4
Type@100ms "img"
Sleep 1.2
Down
Sleep 0.6
Down
Sleep 1.1
Enter
Sleep 1.5
