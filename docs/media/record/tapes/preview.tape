# Предпросмотр: сводка директории, исходники, прокрутка, поиск в просмотре,
# перенос строк, поиск по имени.
Hide
Type "@JANUS@ --lang @LANG@ ~/demo ~/demo/downloads"
Enter
Sleep 1.5
Down
Sleep 0.3
Show
Sleep 0.1
Down@100ms 3
Enter
Sleep 0.55
Down@120ms 2
Type "p"
Sleep 1
Down
Sleep 0.7
Down
Sleep 0.68
Down
Sleep 0.7
Down
Sleep 1.1
Up@100ms 4
Right
Sleep 0.62
Down
Sleep 0.58
Down
Sleep 0.58
Tab
Sleep 0.62
PageDown
Sleep 0.7
Type "/"
Sleep 0.3
Type@100ms "dirty"
Sleep 0.95
Right
Sleep 0.5
Right
Sleep 0.46
Right
Sleep 2.5
Escape
Sleep 0.38
Type "w"
Sleep 0.94
Type "w"
Sleep 0.66
Tab
Sleep 0.38
Left@50ms 2
Sleep 0.58
Type "f"
Sleep 0.38
Type@85ms "app.log"
Sleep 2.9
Enter
Sleep 1
